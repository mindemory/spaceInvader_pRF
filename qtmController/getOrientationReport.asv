%     vec = point - plane_point;
%     dist = dot(vec, plane_normal);
%     proj_point = point - dist * plane_normal;
% end

figure;
hold on;

for m = 1:numMarkersUsed
    scatter3(projected_points(:, m, 1), projected_points(:, m, 2), projected_points(:, m, 3), 'black', 'filled');
    scatter3(markerHolder(:, m, 1), markerHolder(:, m, 2), markerHolder(:, m, 3), 'blue', 'filled');   
    scatter3(flattened_points(:, m, 1), flattened_points(:, m, 2), flattened_points(:, m, 3), 'red', 'filled');   
end

%%
% For each projected point, check the distance to the plane
distances = zeros(size(projected_points,1), size(projected_points,2));
for k = 1:size(projected_points,1)
    for m = 1:size(projected_points,2)
        pt = squeeze(projected_points(k,m,:));
        distances(k,m) = dot(pt - ref_points(1,:)', normal_vec');
    end
end

% The values in 'distances' should be close to zero everywhere
max_abs_distance = max(abs(distances(:)));
disp(['Max absolute distance from plane: ', num2str(max_abs_distance)]);

